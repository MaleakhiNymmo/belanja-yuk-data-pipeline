# ============================================================
# Custom Airflow Image untuk Belanja Yuk Data Pipeline
# Base: official apache/airflow:2.9.3
# Tambahan: dbt-core, psycopg2, faker, pytest, dll
#
# Note: git & curl sudah pre-installed di base image,
# tidak perlu apt-get install lagi.
# ============================================================

FROM apache/airflow:2.9.3

# Tetap sebagai user airflow (default di base image)
# Copy requirements dulu (layer caching: kalau requirements.txt
# tidak berubah, pip install tidak akan diulang)
COPY requirements.txt /requirements.txt

# Install semua Python dependencies
RUN pip install --no-cache-dir -r /requirements.txt
