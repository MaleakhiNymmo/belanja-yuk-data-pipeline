# ============================================================
# Belanja Yuk — Data Pipeline
# Copy file ini jadi .env dan isi nilainya
# ============================================================

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=apache/airflow:2.9.3
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here
AIRFLOW__WEBSERVER__SECRET_KEY=your_secret_key_here

# --- Postgres (Data Warehouse) ---
DWH_POSTGRES_USER=dwh_user
DWH_POSTGRES_PASSWORD=dwh_password
DWH_POSTGRES_DB=belanja_yuk_dwh
DWH_POSTGRES_HOST=postgres_dwh
DWH_POSTGRES_PORT=5432

# --- Airflow Metadata DB (pisah dari DWH) ---
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow_metadata

# --- Slack Alerting ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# --- dbt ---
DBT_PROFILES_DIR=/opt/airflow/dbt
DBT_PROJECT_DIR=/opt/airflow/dbt/belanja_yuk
